datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Product {
  id          String   @id @default(uuid())
  titleUz     String
  titleRu     String
  titleEn     String
  titleFa     String   @default("") @map("titleAr") // 4th language is Persian (fa)
  descUz      String
  descRu      String
  descEn      String
  descFa      String   @default("") @map("descAr")
  category    String   // Premium, Grade 1, Grade 2, Bran, Grain
  packaging   String   // e.g. "50 kg, 25 kg, 10 kg, 5 kg"
  gluten      String?  // e.g. "28-30%"
  ash         String?  // e.g. "0.55%"
  moisture    String?  // e.g. "14.2%"
  imageUrl    String
  isFeatured  Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("products")
}

model Photo {
  id        String   @id @default(uuid())
  photoUrl  String
  titleUz   String?
  titleRu   String?
  titleEn   String?
  titleFa   String?  @map("titleAr")
  category  String   @default("production") // production, laboratory, factory, team
  width     Int      @default(1080)
  height    Int      @default(720)
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("photos")
}

/// Hero slider on the home page
model Banner {
  id        String   @id @default(uuid())
  imageUrl  String
  titleUz   String   @default("")
  titleRu   String   @default("")
  titleEn   String   @default("")
  titleFa   String   @default("")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}

enum PostType {
  NEWS
  VACANCY
}

/// News articles and job vacancies (cards on the home page + /news, /vacancies pages)
model Post {
  id          String   @id @default(uuid())
  type        PostType
  imageUrl    String   @default("")
  titleUz     String
  titleRu     String   @default("")
  titleEn     String   @default("")
  titleFa     String   @default("")
  /// Plain text; blank lines separate paragraphs
  bodyUz      String   @default("")
  bodyRu      String   @default("")
  bodyEn      String   @default("")
  bodyFa      String   @default("")
  date        DateTime @default(now())
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, isPublished, date])
  @@map("posts")
}

enum InfoKind {
  MOTTO
  FAQ
}

/// Short text blocks: the 3 "motto" cards under the hero and the FAQ accordion
model InfoItem {
  id        String   @id @default(uuid())
  kind      InfoKind
  titleUz   String
  titleRu   String   @default("")
  titleEn   String   @default("")
  titleFa   String   @default("")
  bodyUz    String   @default("")
  bodyRu    String   @default("")
  bodyEn    String   @default("")
  bodyFa    String   @default("")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, order])
  @@map("info_items")
}

model Partner {
  id         String   @id @default(uuid())
  name       String
  logoUrl    String
  websiteUrl String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("partners")
}

model Inquiry {
  id        String        @id @default(uuid())
  fullName  String
  phone     String
  email     String?
  subject   String?
  message   String
  fileUrl   String?
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("inquiries")
}

/// Every file stored on the backend (uploads/). Deduplicated by SHA-256 hash.
model Media {
  id           String   @id @default(uuid())
  /// File name inside UPLOAD_DIR, e.g. "img-3f9a…c1.jpg"
  filename     String   @unique
  /// Public URL path, e.g. "/uploads/img-3f9a…c1.jpg"
  url          String   @unique
  hash         String   @unique
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  originalName String?
  /// Where the file came from (original path or remote URL) — used by the importer to stay idempotent
  source       String?
  alt          String?
  createdAt    DateTime @default(now())

  @@index([source])
  @@map("media")
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("settings")
}
