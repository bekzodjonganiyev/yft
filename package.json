{
  "name": "yangiyer-flour-trading-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Yangiyer Flour Trading (YFT) Unified PNPM Monorepo: User Next.js Portal, Admin Shadcn Portal, and Express+Prisma Backend.",
  "scripts": {
    "dev": "pnpm --parallel run dev",
    "dev:user": "pnpm --filter @yft/user dev",
    "dev:admin": "pnpm --filter @yft/admin dev",
    "dev:back": "pnpm --filter @yft/backend dev",
    "build": "pnpm --recursive run build",
    "build:user": "pnpm --filter @yft/user build",
    "build:admin": "pnpm --filter @yft/admin build",
    "build:back": "pnpm --filter @yft/backend build",
    "prisma:generate": "pnpm --filter @yft/backend prisma:generate",
    "prisma:migrate": "pnpm --filter @yft/backend prisma:migrate",
    "prisma:seed": "pnpm --filter @yft/backend prisma:seed"
  },
  "keywords": [
    "yangiyer-flour-trading",
    "monorepo",
    "pnpm",
    "nextjs",
    "shadcn-admin",
    "express",
    "prisma"
  ],
  "author": "bekzodjonganiyev",
  "license": "ISC"
}
